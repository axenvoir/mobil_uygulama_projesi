{
  "expo": {
    "name": "Expira",
    "slug": "expira",
    "version": "1.1.3",
    "description": "Track product expiry dates, organize your pantry, and get timely reminders.",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/branding/expira-icon.png",
    "assetBundlePatterns": [
      "assets/images/android-icon-foreground.png",
      "assets/images/android-icon-monochrome.png",
      "assets/images/splash-icon.png"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.expira.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Expira accesses your photo library to attach photos to products.",
        "NSCameraUsageDescription": "Expira uses your camera to capture product photos.",
        "NSFaceIDUsageDescription": "Expira uses Face ID to keep your pantry and notes secure.",
        "NSCalendarsUsageDescription": "Expira adds expiry reminders to your calendar."
      }
    },
    "android": {
      "package": "com.expira.app.tr",
      "versionCode": 40,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#153F38"
      },
      "permissions": [
        "CAMERA",
        "USE_BIOMETRIC",
        "VIBRATE",
        "READ_CALENDAR",
        "WRITE_CALENDAR",
        "POST_NOTIFICATIONS",
        "INTERNET"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_SETTINGS"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "jsEngine": "hermes",
            "newArchEnabled": false,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false
          },
          "ios": {
            "jsEngine": "hermes",
            "newArchEnabled": false
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#153F38"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Expira accesses your photo library to attach photos to products.",
          "cameraPermission": "Expira uses your camera to capture product photos.",
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Expira uses Face ID to keep your pantry and notes secure."
        }
      ],
      "expo-localization",
      [
        "expo-calendar",
        {
          "calendarPermission": "Expira adds product expiry reminders to your calendar."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#267968",
          "defaultChannel": "default",
          "sounds": []
        }
      ],
      "expo-sharing",
      "expo-font"
    ]
  }
}

{
  "expo": {
    "name": "Expira",
    "slug": "expira",
    "version": "1.1.3",
    "description": "Track product expiry dates, organize your pantry, and get timely reminders.",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.expira.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Expira, \u00fcr\u00fcnlerine foto\u011fraf eklemek i\u00e7in galerine eri\u015fir.",
        "NSCameraUsageDescription": "Expira, \u00fcr\u00fcn foto\u011fraf\u0131 \u00e7ekmek i\u00e7in kameran\u0131 kullan\u0131r.",
        "NSFaceIDUsageDescription": "Expira, uygulamay\u0131 g\u00fcvenli tutmak i\u00e7in Face ID kullan\u0131r.",
        "NSCalendarsUsageDescription": "Expira, SKT hat\u0131rlat\u0131c\u0131lar\u0131n\u0131 takvimine eklemek i\u00e7in izin ister."
      }
    },
    "android": {
      "package": "com.expira.app.tr",
      "versionCode": 37,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#153F38"
      },
      "permissions": [
        "CAMERA",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "VIBRATE",
        "READ_CALENDAR",
        "WRITE_CALENDAR",
        "POST_NOTIFICATIONS",
        "INTERNET"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_SETTINGS"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "jsEngine": "jsc",
            "newArchEnabled": false,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          },
          "ios": {
            "jsEngine": "jsc",
            "newArchEnabled": false
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#153F38"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Expira, \u00fcr\u00fcnlerine foto\u011fraf eklemek i\u00e7in galerine eri\u015fir.",
          "cameraPermission": "Expira, \u00fcr\u00fcn foto\u011fraf\u0131 \u00e7ekmek i\u00e7in kameran\u0131 kullan\u0131r.",
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Expira, uygulamay\u0131 g\u00fcvenli tutmak i\u00e7in Face ID kullan\u0131r."
        }
      ],
      "expo-localization",
      [
        "expo-calendar",
        {
          "calendarPermission": "Expira, SKT hat\u0131rlat\u0131c\u0131lar\u0131n\u0131 takvimine eklemek i\u00e7in izin ister."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#14B8A6",
          "defaultChannel": "default",
          "sounds": []
        }
      ],
      "expo-sharing"
    ],
    "updates": {
      "url": "https://u.expo.dev/a6d69b5f-6d35-4054-aab0-41eb1885ebb3",
      "enabled": true,
      "checkAutomatically": "ON_ERROR",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "a6d69b5f-6d35-4054-aab0-41eb1885ebb3"
      }
    }
  }

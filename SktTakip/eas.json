{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_USE_HERMES": "0"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview",
      "env": {
        "EXPO_USE_HERMES": "0"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "distribution": "store",
      "android": {
        "buildType": "app-bundle",
        "withoutCredentials": false
      },
      "env": {
        "EXPO_USE_HERMES": "0",
        "ANDROID_PROGUARD_MAPPING": "true",
        "ANDROID_PROGUARD_RULES": "proguard-rules.pro"
      }
    }
  },
  "submit": {
    "production": {}
  }
}